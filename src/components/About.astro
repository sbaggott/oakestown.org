---
const db = Astro.locals.runtime.env.prod_d1_oakestown;
const { results: paragraphs } = await db.prepare('SELECT * FROM about_paragraphs ORDER BY position').all();
---

<section id="about" class="about" aria-labelledby="about-heading">
  <div class="container">
    <h2 class="section-title" id="about-heading">About</h2>
    <div class="about-body">
      {(paragraphs as string[]).map((p: any) => (
        <p set:html={p.content} />
      ))}
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--bg-alt);
  }

  .about-body p {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 18px;
    //max-width: 700px;
  }

  .about-body p:last-child {
    margin-bottom: 0;
  }
</style>
