---
interface Props {
  title: string;
  publisher: string;
  year: number;
  description: Array<string>;
  endorsements: Array<{ quote: string; attribution: string }>;
  cover?: string;
}

const {title, publisher, year, description, endorsements, cover} = Astro.props;
---

<div>
  {cover && (
    <img
      src={cover}
      class="book-cover"
      alt={`Cover of ${title}`}
      loading="lazy"
    />
  )}
  <h3>{title}</h3>
  <p class="publisher">{publisher}, {year}</p>
  {description.map((paragraph: string) => (
    <p class="description" set:html={paragraph}/>
  ))}
  {endorsements.length > 0 && endorsements.map((endorsement) => (
    <blockquote>
      <p>“{endorsement.quote}”</p>
      <cite>— {endorsement.attribution}</cite>
    </blockquote>
  ))}
</div>

<style>
  img.book-cover {
    float: left;
    margin-right: 24px;
    width: 200px;
    border: 1px solid var(--border);
  }

  .cover-placeholder {
    display: none;
    width: 100px;
    height: 150px;
    background: #f0ece8;
    border: 1px solid var(--border);
  }

  .book-info h3 {
    font-family: var(--font-heading), sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 4px;
    line-height: 1.3;
  }

  .publisher {
    font-family: var(--font-heading), sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .description {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 12px;
  }

  blockquote {
    border-left: 2px solid var(--accent);
    padding-left: 12px;
    margin-top: 16px;
  }

  blockquote p {
    font-size: 0.9rem;
    font-style: italic;
    color: var(--text-muted);
    line-height: 1.6;
  }

  blockquote cite {
    display: block;
    font-size: 0.8rem;
    font-style: normal;
    font-family: var(--font-heading), sans-serif;
    color: var(--text-muted);
    margin-top: 6px;
  }

  @media only screen and (min-width: 360px) and (max-width: 768px) {
    img.book-cover {
      margin-right: 12px;
      width: 100px;
    }

    .book-info h3 {
      font-size: 0.7rem;
      line-height: 1.2;
    }
  }
</style>
