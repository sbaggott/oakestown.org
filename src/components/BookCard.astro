---
interface Props {
  title: string;
  publisher: string;
  year: number;
  description: string;
  endorsements: Array<{ quote: string; attribution: string }>;
  cover?: string;
}

const { title, publisher, year, description, endorsements, cover } = Astro.props;
---

<div class="book-card">
  <div class="book-cover">
    {cover && (
      <img
        src={cover}
        alt={`Cover of ${title}`}
        loading="lazy"
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
      />
    )}
    <div class="cover-placeholder" aria-hidden="true"></div>
  </div>
  <div class="book-info">
    <h3>{title}</h3>
    <p class="publisher">{publisher}, {year}</p>
    <p class="description">{description}</p>
    {endorsements.length > 0 && (
      <blockquote>
        <p>"{endorsements[0].quote}"</p>
        <cite>— {endorsements[0].attribution}</cite>
      </blockquote>
    )}
  </div>
</div>

<style>
  .book-card {
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }

  .book-cover {
    flex-shrink: 0;
    width: 100px;
  }

  .book-cover img {
    width: 100px;
    border: 1px solid var(--border);
  }

  .cover-placeholder {
    display: none;
    width: 100px;
    height: 150px;
    background: #f0ece8;
    border: 1px solid var(--border);
  }

  .book-info h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 4px;
    line-height: 1.3;
  }

  .publisher {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .description {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 12px;
  }

  blockquote {
    border-left: 2px solid var(--accent);
    padding-left: 12px;
    margin-top: 10px;
  }

  blockquote p {
    font-size: 0.88rem;
    font-style: italic;
    color: var(--text-muted);
    line-height: 1.6;
  }

  blockquote cite {
    display: block;
    font-size: 0.78rem;
    font-style: normal;
    font-family: var(--font-heading);
    color: var(--text-muted);
    margin-top: 6px;
  }
</style>
