---
import BookCard from './BookCard.astro';

interface Book {
  title: string;
  publisher: string;
  year: number;
  description: Array<string>;
  endorsements: Array<{ quote: string; attribution: string }>;
  cover: string;
}

const db = Astro.locals.runtime.env.prod_d1_oakestown;

const { results: rawBooks } = await db.prepare('SELECT * FROM books ORDER BY sort_order').all();
const { results: rawDescs } = await db.prepare('SELECT * FROM book_descriptions ORDER BY book_id, position').all();
const { results: rawEndorsements } = await db.prepare('SELECT * FROM book_endorsements ORDER BY book_id, position').all();

const books = rawBooks.map((book: any): Book => ({
  title: book.title,
  publisher: book.publisher,
  year: book.year,
  cover: book.cover ?? '',
  description: (rawDescs as any[]).filter(d => d.book_id === book.id).map(d => d.paragraph),
  endorsements: (rawEndorsements as any[]).filter(e => e.book_id === book.id).map(e => ({ quote: e.quote, attribution: e.attribution })),
}));
---

<section id="books" class="books" aria-labelledby="books-heading">
  <div class="container">
    <h2 class="section-title" id="books-heading">Selected Works</h2>
    <div class="books-list">
      {books.map(book => (
        <BookCard
          title={book.title}
          publisher={book.publisher}
          year={book.year}
          description={book.description}
          endorsements={book.endorsements}
          cover={book.cover}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .books-list {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
</style>
