---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <p class="copyright">&copy; {currentYear} Kaya Oakes</p>
  </div>
</footer>

<style>
  .footer {
    padding: 32px 40px;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .copyright {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-muted);
  }
</style>
