---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-photo">
      <img
        src="/images/kaya-hero.jpg"
        alt="Kaya Oakes"
        width="225"
        height="225"
        loading="eager"
      />
    </div>
    <div class="hero-text">
      <h1>Kaya Oakes</h1>
      <p class="tagline">Essayist &middot; Journalist &middot; Teacher</p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 40px 40px;
    border-top: none;
    background-image: url('/images/hero-bkgrnd.jpg');
    background-size: cover;
    background-position: center 80%;
    background-blend-mode: overlay;
  }

  .hero-inner {
    display: flex;
    align-items: center;
    margin: 0 auto;
    width: 100%;
    max-width: 800px;
    gap: 60px;
  }

  .hero-photo {
    flex-shrink: 0;
    position: relative;
    width: 225px;
    height: 225px;
  }

  .hero-photo img {
    width: 225px;
    height: 225px;
    border-radius: 50%;
    object-fit: cover;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-text h1 {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--bg);
    line-height: 1.0;
    margin-bottom: 16px;
  }

  .tagline {
    font-family: var(--font-heading);
    font-size: 1rem;
    letter-spacing: 1.5px;
    color: var(--accent);
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .hero-inner {
      flex-direction: column;
      gap: 32px;
      text-align: center;
    }

    .hero-photo {
      width: 225px;
      height: 225px;
    }

    .hero-photo img {
      width: 225px;
      height: 225px;
    }

    .hero-text {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-text h1 {
      font-size: clamp(1.5rem, 5vw, 1.8rem);
    }

    .tagline {
      font-size: 0.8rem;
      letter-spacing: 1.2px;
    }
  }
</style>
